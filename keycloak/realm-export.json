{
  "realm": "change-gate",
  "enabled": true,
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "change:read",
      "description": "Read change context (requests, policy, graph, freeze, history).",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "change:approve",
      "description": "Record a change decision (governed write).",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "change:approve:prod",
      "description": "Elevated: approve changes in the prod environment.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    }
  ],
  "clients": [
    {
      "clientId": "change-gate-agent",
      "name": "Change-Gate Agent (service account, demo)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "agent-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:9099/callback", "http://127.0.0.1:9099/callback"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300"
      },
      "defaultClientScopes": ["change:read", "change:approve", "change:approve:prod"],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "acme",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "role",
            "claim.value": "lead",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "http://localhost:9000/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "change-gate-agent-base",
      "name": "Change-Gate Agent (base scope only — for negative tests)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "agent-base-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["change:read", "change:approve"],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "acme",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "role",
            "claim.value": "lead",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "http://localhost:9000/mcp",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
